// Safe defaults keep local-only development builds runnable.
GOOGLE_IOS_CLIENT_ID = replace-with-google-ios-client-id
GOOGLE_REVERSED_CLIENT_ID = replace-with-google-reversed-client-id
GOOGLE_SERVER_CLIENT_ID = replace-with-google-server-client-id
FACEBOOK_APP_ID = replace-with-facebook-app-id
FACEBOOK_CLIENT_TOKEN = replace-with-facebook-client-token

// Generated by scripts/configure_stage_auth.sh and intentionally ignored.
#include? "Authentication.local.xcconfig"
